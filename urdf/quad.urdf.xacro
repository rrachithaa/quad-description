<?xml version="1.0"?>
<robot name="quad" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="body_l" value="0.40"/>
  <xacro:property name="body_w" value="0.20"/>
  <xacro:property name="body_h" value="0.08"/>
  <xacro:property name="body_m" value="4.0"/>
  <xacro:property name="thigh_l" value="0.20"/>
  <xacro:property name="shin_l" value="0.20"/>
  <xacro:property name="leg_r" value="0.015"/>
  <xacro:property name="leg_m" value="0.2"/>

  <material name="grey"><color rgba="0.6 0.6 0.65 1"/></material>
  <material name="orange"><color rgba="0.9 0.4 0.1 1"/></material>
  <material name="dark"><color rgba="0.15 0.15 0.15 1"/></material>

  <!-- Inertia of a cylinder whose axis is z, centred at z = -l/2 -->
  <xacro:macro name="leg_link" params="name l mat">
    <link name="${name}">
      <visual>
        <origin xyz="0 0 ${-l/2}"/>
        <geometry><cylinder radius="${leg_r}" length="${l}"/></geometry>
        <material name="${mat}"/>
      </visual>
      <collision>
        <origin xyz="0 0 ${-l/2}"/>
        <geometry><cylinder radius="${leg_r}" length="${l}"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 ${-l/2}"/>
        <mass value="${leg_m}"/>
        <inertia ixx="${leg_m*(3*leg_r*leg_r+l*l)/12}" iyy="${leg_m*(3*leg_r*leg_r+l*l)/12}"
                 izz="${leg_m*leg_r*leg_r/2}" ixy="0" ixz="0" iyz="0"/>
      </inertial>
    </link>
  </xacro:macro>

  <xacro:macro name="leg" params="name x y side">
    <!-- hip: small sphere at the body corner -->
    <link name="${name}_hip">
      <visual><geometry><sphere radius="0.03"/></geometry><material name="dark"/></visual>
      <collision><geometry><sphere radius="0.03"/></geometry></collision>
      <inertial>
        <mass value="0.2"/>
        <inertia ixx="7.2e-5" iyy="7.2e-5" izz="7.2e-5" ixy="0" ixz="0" iyz="0"/>
      </inertial>
    </link>
    <joint name="${name}_hip_joint" type="revolute">
      <parent link="base_link"/><child link="${name}_hip"/>
      <origin xyz="${x} ${y} 0"/>
      <axis xyz="1 0 0"/>
      <limit lower="-0.6" upper="0.6" effort="20" velocity="10"/>
      <dynamics damping="0.1" friction="0.0"/>
    </joint>

    <xacro:leg_link name="${name}_thigh" l="${thigh_l}" mat="orange"/>
    <joint name="${name}_thigh_joint" type="revolute">
      <parent link="${name}_hip"/><child link="${name}_thigh"/>
      <origin xyz="0 ${side*0.04} 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="-1.5" upper="1.5" effort="20" velocity="10"/>
      <dynamics damping="0.1" friction="0.0"/>
    </joint>

    <xacro:leg_link name="${name}_shin" l="${shin_l}" mat="grey"/>
    <joint name="${name}_knee_joint" type="revolute">
      <parent link="${name}_thigh"/><child link="${name}_shin"/>
      <origin xyz="0 0 ${-thigh_l}"/>
      <axis xyz="0 1 0"/>
      <limit lower="-2.6" upper="-0.2" effort="20" velocity="10"/>
      <dynamics damping="0.1" friction="0.0"/>
    </joint>

    <link name="${name}_foot">
      <visual><geometry><sphere radius="0.02"/></geometry><material name="dark"/></visual>
      <collision><geometry><sphere radius="0.02"/></geometry></collision>
      <inertial>
        <mass value="0.02"/>
        <inertia ixx="3.2e-6" iyy="3.2e-6" izz="3.2e-6" ixy="0" ixz="0" iyz="0"/>
      </inertial>
    </link>
    <joint name="${name}_foot_joint" type="fixed">
      <parent link="${name}_shin"/><child link="${name}_foot"/>
      <origin xyz="0 0 ${-shin_l}"/>
    </joint>
  </xacro:macro>

  <link name="base_link">
    <visual>
      <geometry><box size="${body_l} ${body_w} ${body_h}"/></geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <geometry><box size="${body_l} ${body_w} ${body_h}"/></geometry>
    </collision>
    <inertial>
      <mass value="${body_m}"/>
      <inertia ixx="${body_m*(body_w*body_w+body_h*body_h)/12}"
               iyy="${body_m*(body_l*body_l+body_h*body_h)/12}"
               izz="${body_m*(body_l*body_l+body_w*body_w)/12}" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <xacro:leg name="fl" x="0.15"  y="0.10"  side="1"/>
  <xacro:leg name="fr" x="0.15"  y="-0.10" side="-1"/>
  <xacro:leg name="rl" x="-0.15" y="0.10"  side="1"/>
  <xacro:leg name="rr" x="-0.15" y="-0.10" side="-1"/>

</robot>
